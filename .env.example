# Environment variables for Ori-Relay

# Per-Ori API keys (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ORI_ALPHA_KEY=your_alpha_api_key_here
ORI_BETA_KEY=your_beta_api_key_here

# Encryption key for messages at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# Relay server settings
RELAY_PORT=18792
RELAY_HOST=0.0.0.0